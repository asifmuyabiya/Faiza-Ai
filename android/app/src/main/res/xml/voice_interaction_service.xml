<?xml version="1.0" encoding="utf-8"?>
<!-- Lets Faiza be chosen as the phone's Digital assistant app (video 7:56). -->
<voice-interaction-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:recognitionService="com.faiza.ai.assist.FaizaRecognitionService"
    android:sessionService="com.faiza.ai.assist.FaizaAssistSessionService"
    android:settingsActivity="com.faiza.ai.ui.SettingsActivity"
    android:supportsAssist="true"
    android:supportsLaunchVoiceAssistFromKeyguard="true"
    android:supportsLocalInteraction="true" />
