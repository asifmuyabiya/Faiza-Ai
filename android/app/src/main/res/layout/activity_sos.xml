<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="28dp">

        <LinearLayout style="@style/Widget.Faiza.TopBar">

            <ImageButton
                android:id="@+id/btnBack"
                style="@style/Widget.Faiza.BackButton" />

            <TextView
                style="@style/Text.Faiza.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="SOS" />
        </LinearLayout>

        <TextView
            style="@style/Text.Faiza.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="In danger? Press SOS or say &quot;SOS&quot; / &quot;বাঁচাও&quot;. After 5 seconds your SOS contacts get a text with your location, then Faiza calls them one by one." />

        <!-- Big button -->
        <FrameLayout
            android:id="@+id/btnSos"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_sos_button"
            android:clickable="true"
            android:contentDescription="Send SOS"
            android:focusable="true">

            <TextView
                android:id="@+id/tvSosButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-medium"
                android:text="SOS"
                android:textColor="#FFFFFF"
                android:textSize="40sp" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvSosStatus"
            style="@style/Text.Faiza.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Tap to send SOS" />

        <!-- Who -->
        <TextView
            style="@style/Text.Faiza.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Who gets your SOS" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/rowSosContacts"
                style="@style/Widget.Faiza.Row">

                <ImageView
                    style="@style/Widget.Faiza.IconTile"
                    android:src="@drawable/ic_person" />

                <LinearLayout style="@style/Widget.Faiza.RowText">

                    <TextView
                        style="@style/Widget.Faiza.RowTitle"
                        android:text="SOS contacts" />

                    <TextView
                        android:id="@+id/tvSosContacts"
                        style="@style/Widget.Faiza.RowSubtitle"
                        android:text="None yet — tap to add" />
                </LinearLayout>

                <ImageView style="@style/Widget.Faiza.Chevron" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:id="@+id/rowSosMessage"
                style="@style/Widget.Faiza.Row">

                <ImageView
                    style="@style/Widget.Faiza.IconTile"
                    android:src="@drawable/ic_chat" />

                <LinearLayout style="@style/Widget.Faiza.RowText">

                    <TextView
                        style="@style/Widget.Faiza.RowTitle"
                        android:text="Extra message" />

                    <TextView
                        android:id="@+id/tvSosMessage"
                        style="@style/Widget.Faiza.RowSubtitle"
                        android:text="Optional, e.g. blood group or medical info" />
                </LinearLayout>

                <ImageView style="@style/Widget.Faiza.Chevron" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSosTest"
            style="@style/Widget.Faiza.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Test SOS (nothing is sent)"
            app:icon="@drawable/ic_info" />

        <!-- Permissions -->
        <TextView
            style="@style/Text.Faiza.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Needed permissions" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/sosPermissions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Text.Faiza.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Faiza is not an emergency service. In a life-threatening emergency also call 999 (Bangladesh) or 112 (India)."
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
