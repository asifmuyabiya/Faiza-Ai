<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="28dp">

        <LinearLayout style="@style/Widget.Faiza.TopBar">

            <ImageButton
                android:id="@+id/btnBack"
                style="@style/Widget.Faiza.BackButton" />

            <TextView
                style="@style/Text.Faiza.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Memory" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMemoryStatus"
            style="@style/Text.Faiza.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="What Faiza remembers about you. Only on this phone." />

        <!-- MAYA Memories tab: trained tasks (macros) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTrainedTasks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout style="@style/Widget.Faiza.Row">

                <ImageView
                    style="@style/Widget.Faiza.IconTile"
                    android:background="@drawable/bg_tile_orange"
                    android:src="@drawable/ic_bolt"
                    app:tint="@color/tile_orange" />

                <LinearLayout style="@style/Widget.Faiza.RowText">

                    <TextView
                        style="@style/Widget.Faiza.RowTitle"
                        android:text="Trained tasks" />

                    <TextView
                        android:id="@+id/tvTrainedTasks"
                        style="@style/Widget.Faiza.RowSubtitle"
                        android:text="4 macros · Ask ChatGPT, Ask Gemini…" />
                </LinearLayout>

                <ImageView style="@style/Widget.Faiza.Chevron" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <EditText
            android:id="@+id/etSearch"
            style="@style/Widget.Faiza.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Search memories"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1" />

        <TextView
            android:id="@+id/tvFactsHeader"
            style="@style/Text.Faiza.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Things I remember" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/factsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            style="@style/Text.Faiza.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Conversation history" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout style="@style/Widget.Faiza.Row">

                <ImageView
                    style="@style/Widget.Faiza.IconTile"
                    android:src="@drawable/ic_chat" />

                <LinearLayout style="@style/Widget.Faiza.RowText">

                    <TextView
                        style="@style/Widget.Faiza.RowTitle"
                        android:text="Saved conversation lines" />

                    <TextView
                        android:id="@+id/tvLogCount"
                        style="@style/Widget.Faiza.RowSubtitle"
                        android:text="0 lines" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearLog"
            style="@style/Widget.Faiza.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Clear conversation history"
            app:icon="@drawable/ic_delete" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearAll"
            style="@style/Widget.Faiza.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Forget everything"
            android:textColor="@color/danger"
            app:icon="@drawable/ic_delete"
            app:iconTint="@color/danger" />

    </LinearLayout>
</ScrollView>
