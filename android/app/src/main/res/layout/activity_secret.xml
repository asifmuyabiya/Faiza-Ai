<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp">

        <LinearLayout style="@style/Widget.Faiza.TopBar">

            <ImageButton
                android:id="@+id/btnBack"
                style="@style/Widget.Faiza.BackButton" />

            <TextView
                style="@style/Text.Faiza.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Secret settings" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        style="@style/Widget.Faiza.IconTile"
                        android:background="@drawable/bg_tile_pink"
                        android:src="@drawable/ic_heart"
                        app:tint="@color/tile_pink" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.Faiza.RowTitle"
                            android:text="How close she is" />

                        <TextView
                            style="@style/Widget.Faiza.RowSubtitle"
                            android:text="Friendly, Romantic or Intense (18+)" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/levelList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />

                <TextView
                    style="@style/Text.Faiza.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_empty_card"
                    android:padding="12dp"
                    android:text="💡 Takes effect the next time she starts. Can't be switched by voice." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        style="@style/Widget.Faiza.IconTile"
                        android:background="@drawable/bg_tile_violet"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/tile_violet" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Widget.Faiza.RowTitle"
                            android:text="What each level allows" />

                        <TextView
                            style="@style/Widget.Faiza.RowSubtitle"
                            android:text="So you know before you pick" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/Text.Faiza.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_empty_card"
                    android:lineSpacingMultiplier="1.3"
                    android:padding="14dp"
                    android:text="Friendly: frank, unjudging answers about adult topics, no flirting, no scenes. Romantic: flirting with some warmth and innuendo, a fade to black. Intense (18+): more open and forward in words — and Google's own filter still sits above all of this." />

                <TextView
                    style="@style/Text.Faiza.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_empty_card"
                    android:lineSpacingMultiplier="1.3"
                    android:padding="14dp"
                    android:text="⚠️ Nothing involving anyone under 18, at any level, in any form. If a child's voice or words are heard, the level drops to Friendly for the rest of that conversation." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
