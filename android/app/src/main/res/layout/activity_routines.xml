<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp">

        <LinearLayout style="@style/Widget.Faiza.TopBar">

            <ImageButton
                android:id="@+id/btnBack"
                style="@style/Widget.Faiza.BackButton" />

            <TextView
                style="@style/Text.Faiza.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Routines" />
        </LinearLayout>

        <TextView
            style="@style/Text.Faiza.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:text="Faiza does things on time and keeps an eye out for you." />

        <!-- Shown only when something is missing -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardNotifAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <LinearLayout style="@style/Widget.Faiza.Row">

                <ImageView
                    style="@style/Widget.Faiza.IconTile"
                    android:background="@drawable/bg_tile_amber"
                    android:src="@drawable/ic_bell"
                    app:tint="@color/tile_amber" />

                <LinearLayout style="@style/Widget.Faiza.RowText">

                    <TextView
                        style="@style/Widget.Faiza.RowTitle"
                        android:text="Allow notification access" />

                    <TextView
                        style="@style/Widget.Faiza.RowSubtitle"
                        android:text="Needed to watch for new messages" />
                </LinearLayout>

                <ImageView style="@style/Widget.Faiza.Chevron" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Scheduled -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/Text.Faiza.Section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:layout_marginBottom="0dp"
                android:layout_weight="1"
                android:text="Scheduled" />

            <TextView
                android:id="@+id/btnNewTask"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="8dp"
                android:paddingBottom="6dp"
                android:text="+ New"
                android:textColor="@color/primary_light"
                android:textSize="14sp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTasks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/taskList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvTasksEmpty"
            style="@style/Text.Faiza.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_empty_card"
            android:gravity="center"
            android:padding="20dp"
            android:text="Nothing scheduled. Say “Remind me at 9 pm to take my medicine”." />

        <!-- Watching -->
        <TextView
            style="@style/Text.Faiza.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Watching" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardWatches"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/watchList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvWatchesEmpty"
            style="@style/Text.Faiza.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_empty_card"
            android:gravity="center"
            android:padding="20dp"
            android:text="Not watching anything. Say “Tell me when Rahim messages”." />

        <!-- Ideas -->
        <TextView
            style="@style/Text.Faiza.Section"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Try saying" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                style="@style/Text.Faiza.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.5"
                android:padding="16dp"
                android:text="“Every morning at 7, tell me the weather”&#10;“In 30 minutes, remind me to call Mom”&#10;“On Fridays at 6 pm, run my Good evening macro”&#10;“Tell me when Rahim messages on WhatsApp”&#10;“Until 7 am, reply to WhatsApp: I'm asleep, will call later”&#10;“Tell me when the download finishes”"
                android:textColor="@color/text_primary" />
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
