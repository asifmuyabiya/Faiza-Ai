<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#2B1A5E"
                android:centerColor="#16122E"
                android:endColor="#0E0E16"
                android:type="linear" />
            <corners android:radius="28dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#3A2E6E" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
