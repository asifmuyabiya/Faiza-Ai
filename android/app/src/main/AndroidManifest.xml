<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.faiza.ai">

    <!-- ============ PERMISSIONS ============ -->
    <!-- Internet for API calls -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Voice Recognition -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Phone Control -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Answer / reject / end calls by voice (MAYA "Answer & manage calls") -->
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />
    <!-- Talk through a Bluetooth headset -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- Notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Floating Orb (overlay) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Foreground Service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- Code Studio: run Python/Node projects in Termux -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!-- Wake Lock (keep listening) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Boot (auto-start) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Scheduled tasks on time (video 40:31). USE_EXACT_ALARM is granted automatically for
         reminder apps on Android 13+; older versions use SCHEDULE_EXACT_ALARM. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Camera (vision feature) -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Storage -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <!-- File assistant: find, read, organize and send any file (sideloaded app, user grants it). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Phone settings: brightness / auto-rotate, and Do Not Disturb -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!-- Vibrate for feedback -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Battery optimization exempt -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- SOS: location link in the emergency text, and knowing if a call was answered -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <!-- "Uninstall <app>": opens Android's own uninstall confirmation -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Skills: alarms & timers -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!-- Skills: see launcher apps (open_app) on Android 11+ -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- To find Google's speech recognizer (Faiza passes voice typing on to it). -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <package android:name="com.termux" />
    </queries>

    <application
        android:name=".FaizaApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Faiza AI"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FaizaAI"
        android:usesCleartextTraffic="true"
        android:requestLegacyExternalStorage="true"
        tools:targetApi="34">

        <!-- ====== MAIN ACTIVITY ====== -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.FaizaAI.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <!-- Quick Settings tile: pull down the shade, tap "Faiza", talk. -->
        <service
            android:name=".assist.FaizaTileService"
            android:exported="true"
            android:icon="@drawable/ic_mic"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- License Activation -->
        <activity android:name=".ui.LicenseActivity"
            android:theme="@style/Theme.FaizaAI" />

        <!-- Settings -->
        <activity android:name=".ui.SettingsActivity"
            android:theme="@style/Theme.FaizaAI" />

        <!-- Dashboard -->
        <activity android:name=".ui.DashboardActivity"
            android:theme="@style/Theme.FaizaAI" />

        <!-- Floating orb settings -->
        <activity android:name=".ui.OrbSettingsActivity"
            android:theme="@style/Theme.FaizaAI" />

        <!-- Contacts & SOS -->
        <activity android:name=".ui.ContactsActivity"
            android:theme="@style/Theme.FaizaAI" />
        <activity android:name=".ui.SosActivity"
            android:launchMode="singleTop"
            android:theme="@style/Theme.FaizaAI" />
        <receiver
            android:name=".ai.sos.SosCancelReceiver"
            android:exported="false" />

        <!-- Voice Guardian -->
        <activity android:name=".ui.VoiceGuardianActivity"
            android:theme="@style/Theme.FaizaAI" />

        <!-- Memory -->
        <activity android:name=".ui.MemoryActivity"
            android:theme="@style/Theme.FaizaAI" />

        <!-- ====== DEFAULT ASSISTANT (video 7:56) ====== -->
        <service
            android:name=".assist.FaizaVoiceInteractionService"
            android:exported="true"
            android:label="Faiza AI"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction_service" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>
        <service
            android:name=".assist.FaizaAssistSessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <service
            android:name=".assist.FaizaRecognitionService"
            android:exported="true"
            android:label="Faiza AI">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_service" />
        </service>
        <activity
            android:name=".assist.AssistActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.FaizaAI.Translucent">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Scheduled tasks & watches (video 40:31) -->
        <activity android:name=".ui.RoutinesActivity"
            android:theme="@style/Theme.FaizaAI" />
        <receiver
            android:name=".ai.routines.RoutineAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <activity android:name=".ui.PhotoActivity"
            android:excludeFromRecents="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.FaizaAI" />
        <receiver
            android:name=".ai.khata.MoneySmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
        <activity android:name=".ui.TestChecklistActivity"
            android:theme="@style/Theme.FaizaAI" />
        <activity android:name=".ui.SetupWizardActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.FaizaAI" />
        <activity android:name=".ui.HelpActivity"
            android:theme="@style/Theme.FaizaAI" />
        <activity android:name=".ui.DrivingActivity"
            android:launchMode="singleTop"
            android:theme="@style/Theme.FaizaAI" />
        <activity android:name=".ui.KhataActivity"
            android:launchMode="singleTop"
            android:theme="@style/Theme.FaizaAI"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.PrayerActivity"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.FaizaAI" />
        <receiver
            android:name=".ai.prayer.PrayerAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
        <activity android:name=".ui.GamingActivity"
            android:launchMode="singleTop"
            android:theme="@style/Theme.FaizaAI" />
        <activity android:name=".ui.CodeStudioActivity"
            android:launchMode="singleTop"
            android:theme="@style/Theme.FaizaAI"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.ResearchActivity"
            android:launchMode="singleTop"
            android:theme="@style/Theme.FaizaAI"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.RulesActivity"
            android:theme="@style/Theme.FaizaAI"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.AvatarSetupActivity"
            android:theme="@style/Theme.FaizaAI" />
        <activity android:name=".ui.SecretSettingsActivity"
            android:theme="@style/Theme.FaizaAI" />

        <activity android:name=".ui.EventTriggersActivity"
            android:theme="@style/Theme.FaizaAI" />
        <activity android:name=".ui.TouchGuardActivity"
            android:theme="@style/Theme.FaizaAI" />

        <!-- Owner lock (secret code) and the invisible intruder-photo screen -->
        <activity android:name=".ui.OwnerLockActivity"
            android:theme="@style/Theme.FaizaAI" />
        <activity android:name=".ui.IntruderCaptureActivity"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=".intruder"
            android:theme="@style/Theme.FaizaAI.Translucent" />

        <receiver
            android:name=".ai.routines.FaizaTimerReceiver"
            android:exported="false" />

        <!-- Life modes: calls declined with a polite text, car Bluetooth starts Driving -->
        <activity android:name=".ui.ModesActivity"
            android:theme="@style/Theme.FaizaAI" />
        <receiver
            android:name=".ai.modes.LifeModeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <!-- Pictures Faiza creates (video 29:43) -->
        <activity android:name=".ui.ImageViewerActivity"
            android:theme="@style/Theme.FaizaAI" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Chat & Scan (video 30:51) -->
        <activity android:name=".ui.ChatActivity"
            android:theme="@style/Theme.FaizaAI"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.ScanActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.FaizaAI"
            android:windowSoftInputMode="adjustResize" />

        <!-- Notifications inbox (MAYA 🔔) -->
        <activity android:name=".ui.ActivityLogActivity"
            android:theme="@style/Theme.FaizaAI" />

        <!-- Macros -->
        <activity android:name=".ui.MacrosActivity"
            android:theme="@style/Theme.FaizaAI" />

        <!-- Skills & Sub-agents -->
        <activity android:name=".ui.SkillsActivity"
            android:theme="@style/Theme.FaizaAI" />

        <!-- API Setup -->
        <activity android:name=".ui.ApiSetupActivity"
            android:theme="@style/Theme.FaizaAI" />

        <!-- ====== FLOATING ORB SERVICE ====== -->
        <service
            android:name=".service.FloatingOrbService"
            android:foregroundServiceType="microphone|specialUse|camera"
            android:exported="false" />

        <!-- ====== ACCESSIBILITY SERVICE ====== -->
        <service
            android:name=".service.FaizaAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>

        <!-- ====== NOTIFICATION LISTENER ====== -->
        <service
            android:name=".service.FaizaNotificationListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- ====== SCREEN CAPTURE SERVICE ====== -->
        <service
            android:name=".service.ScreenCaptureService"
            android:foregroundServiceType="mediaProjection"
            android:exported="false" />

        <!-- ====== VOICE SERVICE ====== -->
        <service
            android:name=".service.VoiceRecognitionService"
            android:foregroundServiceType="specialUse"
            android:exported="false" />

        <!-- ====== BOOT RECEIVER ====== -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
